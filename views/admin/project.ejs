<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Task Tracker</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        .form-container {
            background-color: #f9f9f9;
            border-radius: 8px;
            padding: 20px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .form-container h4 {
            font-size: 1.5rem;
            margin-bottom: 20px;
        }

        .form-container input {
            border-radius: 25px;
        }

        .form-container button {
            border-radius: 25px;
        }

        .table-container {
            margin-top: 30px;
        }
    </style>
</head>

<body>
    <nav class="navbar navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">Task Tracker</a>
            <a class="btn btn-outline-light" href="/logout">Logout</a>
        </div>
    </nav>

    <div class="container mt-4">
        <h2>Welcome <%= user.email %></h2>

        <!-- Add Project Form -->
        <% if (projects.length < 4) { %>
            <div class="form-container mt-5">
                <h4>Add a New Project</h4>
                <form action="/project" method="POST">
                    <div class="mb-3">
                        <label for="title" class="form-label">Project Title</label>
                        <input type="text" name="title" class="form-control form-control-lg" id="title" placeholder="Enter your project title" required>
                    </div>
                    <button type="submit" class="btn btn-success btn-lg w-100">Add Project</button>
                </form>
            </div>
        <% } else { %>
            <p class="text-danger mt-3">Max 4 projects allowed.</p>
        <% } %>

        <!-- Projects Table -->
        <div class="table-container">
            <h4 class="mt-5">Your Projects</h4>
            <% if (projects.length > 0) { %>
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">Project Title</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% projects.forEach((project, index) => { %>
                            <tr>
                                <th scope="row"><%= index + 1 %></th>
                                <td><%= project.title %></td>
                                <td>
                                    <a href="/deleteProject/<%= project._id %>" class="btn btn-sm btn-danger">Delete</a>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            <% } else { %>
                <p>No projects yet. Add a new one to get started!</p>
            <% } %>
        </div>

    </div> <!-- /container -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
